PORT=5000
NODE_ENV=development

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bridgex

MONGO_URI=mongodb://localhost:27017/bridgex_logs

REDIS_URL=redis://localhost:6379

JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=1h

BCRYPT_SALT_ROUNDS=10

CLIENT_URL=http://localhost:5173

# Optional: run `npm test` against a separate database so tests never touch dev data
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bridgex_test

# Request logs are deleted automatically after this many days (MongoDB TTL index)
LOG_RETENTION_DAYS=30

# ---- API gateway (Phase 3) ----
# 64 hex characters (32 bytes). REQUIRED in production; encrypts upstream credentials at rest.
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# GATEWAY_ENCRYPTION_KEY=
# Limits (defaults shown)
# GATEWAY_MAX_BODY_BYTES=1048576
# GATEWAY_MAX_RESPONSE_BYTES=10485760
# GATEWAY_DEFAULT_TIMEOUT_MS=10000
# GATEWAY_MAX_TIMEOUT_MS=30000
# DEVELOPMENT ONLY: comma-separated host:port of local test upstreams allowed to bypass the private-address
# block (e.g. a mock server). The server refuses to start if this is set when NODE_ENV=production.
# GATEWAY_DEV_ALLOWED_UPSTREAMS=127.0.0.1:4010
